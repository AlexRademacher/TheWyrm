--- !u!1001 &6182133674250443387
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1104465688}
    m_Modifications:
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: skipNum
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch1.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch2.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch3.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch4.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[0]
      value: "Hi! Say, I haven\u2019t seen you around before\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[1]
      value: "& 1: I\u2019m new, I came from another village\u2026 2: I don\u2019t
        think we\u2019ve met before"
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[2]
      value: "Really?! What\u2019s it like out there, in another village?!"
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[3]
      value: "1: Err- it\u2019s nice... 2: I don\u2019t remember. ^"
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[4]
      value: Glad we have, then! You should visit me and my dad for dinner sometime!
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: lines.Array.data[5]
      value: "^ 1: Who\u2019s your Dad? 2: Sure! What kind of food?"
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch1.Array.data[0]
      value: "Wow, I wish I could go wherever you\u2019re from. I don\u2019t really
        want to stay here."
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch2.Array.data[0]
      value: "Huh. Well whatever its like, it can\u2019t be much worse than here."
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch3.Array.data[0]
      value: "He\u2019s the village farmer! Well not so much a farmer anymore, the
        crops haven\u2019t been growing."
      objectReference: {fileID: 0}
    - target: {fileID: 814429672223048911, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: branch4.Array.data[0]
      value: Ah... um... stale rice? Sorry.
      objectReference: {fileID: 0}
    - target: {fileID: 4404366308514720733, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: MyCameraTransform
      value: 
      objectReference: {fileID: 210288134}
    - target: {fileID: 7114483637293058370, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
      propertyPath: m_LocalScale.x
      value: 0.25
      objectReference: {fileID: 0}
    - target: {fileID: 7114483637293058370, guid: e2dd530e7fe523847a155b249e32cafc, type: 3}
