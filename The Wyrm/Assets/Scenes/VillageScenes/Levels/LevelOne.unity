      objectReference: {fileID: 2100000, guid: 1f35978102dd32f438b31d935963f11b, type: 2}
    - target: {fileID: 7031213288700997578, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: m_Name
      value: NPCSculptSon
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: skipNum
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch1.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch2.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch3.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch4.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[0]
      value: "H-hey there. Who\u2019re you?"
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[1]
      value: "& 1: I\u2019m new, who are you? 2: I live here too. How are you?"
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[2]
      value: "I\u2019m the son of the woodsculptor. Who are your parents?"
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[3]
      value: "1: They\u2019re... around. 2: I don\u2019t have any. ^"
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[4]
      value: "Never noticed you before... I\u2019m okay, things in the village aren\u2019t
        great though."
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: lines.Array.data[5]
      value: "^ 1: It will get better. 2: What\u2019s wrong with the village?"
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch1.Array.data[0]
      value: Hm, okay... still, nice to meet you.
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch2.Array.data[0]
      value: "Oh, I\u2019m sorry to hear that. That seems to be the same answer for
        a lot of people, unfortunately."
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch3.Array.data[0]
      value: "That makes me feel better, thanks. I don\u2019t think it will though..."
      objectReference: {fileID: 0}
    - target: {fileID: 9023407432177182120, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
      propertyPath: branch4.Array.data[0]
      value: Nonstop storms. According to my Dad, it was never this bad before. He
        says the Great Wyrm is angry at us.
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 31f1423616dfe85429f55e3872829c68, type: 3}
